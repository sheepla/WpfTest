<Window x:Class="WpfInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WpfInspector.Core.Models;assembly=WpfInspector.Core"
        xmlns:converters="clr-namespace:WpfInspector.App.Converters"
        mc:Ignorable="d"
        Title="WpfInspector"
        Width="1480"
        Height="920"
        MinWidth="1220"
        MinHeight="760"
        Loaded="OnLoaded"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />

        <Style x:Key="SectionGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SummaryPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinRowHeight" Value="26" />
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusMessageText"
                           Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="処理中" />
                    <ProgressBar Width="180"
                                 Height="14"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <GroupBox DockPanel.Dock="Top"
                  Margin="0,0,0,10"
                  Header="WpfInspector">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="WPF プロセスの UI と PDB を解析するデスクトップツール" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="対象プロセスのモジュール情報、ランタイムのビジュアルツリー、Portable PDB の内容を 1 画面で確認できます。" />
                </StackPanel>

                <GroupBox Grid.Column="1"
                          Header="現在の状態">
                    <StackPanel Margin="8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ProcessCountSummary}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding WpfInspectionSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding RuntimeAssemblySummary}" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </GroupBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="620" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Style="{StaticResource SectionGroupBoxStyle}"
                      Header="プロセス">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Content="フィルター" />
                        <TextBox Grid.Column="1"
                                 x:Name="ProcessFilterTextBox"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                x:Name="RefreshButton"
                                MinWidth="96"
                                Padding="12,4"
                                Click="RefreshButton_OnClick"
                                Content="更新" />
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  x:Name="ShowBackgroundProcessesCheckBox"
                                  VerticalAlignment="Center"
                                  Content="バックグラウンド プロセスも表示"
                                  IsChecked="{Binding ShowBackgroundProcesses}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding ProcessCountSummary}" />
                    </Grid>

                    <DataGrid Grid.Row="2"
                              x:Name="ProcessesGrid"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding ProcessesView}"
                              SelectedItem="{Binding SelectedProcess}"
                              SelectionChanged="ProcessesGrid_OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process"
                                                Width="2*"
                                                Binding="{Binding ProcessName}" />
                            <DataGridTextColumn Header="PID"
                                                Width="90"
                                                Binding="{Binding ProcessId}" />
                            <DataGridCheckBoxColumn Header="Self"
                                                    Width="70"
                                                    Binding="{Binding IsCurrentProcess}" />
                            <DataGridCheckBoxColumn Header="Alive"
                                                    Width="80"
                                                    Binding="{Binding IsResponding}" />
                            <DataGridTextColumn Header="Window Title"
                                                Width="3*"
                                                Binding="{Binding WindowTitle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="3"
                              Header="選択中プロセス">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       x:Name="SelectedProcessHeadlineText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedProcessHeadline}"
                                       TextWrapping="Wrap" />

                            <StackPanel Grid.Row="1"
                                        Margin="0,6,0,0"
                                        Orientation="Horizontal">
                                <TextBlock Visibility="{Binding SelectedProcessSnapshot.Summary.IsCurrentProcess, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="WpfInspector 自身"
                                           FontWeight="SemiBold"
                                           Foreground="DarkBlue" />
                                <TextBlock Margin="12,0,0,0"
                                           Visibility="{Binding IsWpfProcess, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="WPF 検出"
                                           FontWeight="SemiBold"
                                           Foreground="DarkGreen" />
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding SelectedProcessPath}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,6,0,0"
                                       Text="{Binding SelectedProcessMetrics}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding SelectedProcessNotes}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.42*" MinHeight="220" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="0.58*" MinHeight="320" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Style="{StaticResource SectionGroupBoxStyle}"
                          Header="読み込みモジュール">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  x:Name="ModulesGrid"
                                  AutoGenerateColumns="False"
                                  ItemsSource="{Binding Modules}"
                                  SelectedItem="{Binding SelectedModule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module"
                                                    Width="1.5*"
                                                    Binding="{Binding ModuleName}" />
                                <DataGridTextColumn Header="Base"
                                                    Width="115"
                                                    Binding="{Binding BaseAddress, StringFormat=0x{0:X}}" />
                                <DataGridTextColumn Header="Size"
                                                    Width="100"
                                                    Binding="{Binding ModuleMemorySize, StringFormat={}{0:N0}}" />
                                <DataGridTextColumn Header="Symbol"
                                                    Width="140"
                                                    Binding="{Binding SymbolInfo.SymbolState}" />
                                <DataGridCheckBoxColumn Header="PDB"
                                                        Width="72"
                                                        Binding="{Binding SymbolInfo.SuggestedPdbExists}" />
                                <DataGridTextColumn Header="Candidate Path"
                                                    Width="3*"
                                                    Binding="{Binding SymbolInfo.SuggestedPdbPath}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Grid.Row="1"
                                   LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Width="180"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    VerticalAlignment="Top"
                                    IsEnabled="{Binding CanUseSelectedModulePdb}"
                                    Click="UseSelectedModulePdbButton_OnClick"
                                    Content="選択モジュールの PDB を使用" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding SelectedModuleSummary}" />
                                <TextBlock x:Name="SelectedProcessPdbSummaryText"
                                           Margin="0,4,0,0"
                                           Text="{Binding SelectedProcessPdbSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />

                <GroupBox Grid.Row="2"
                          Header="解析">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    x:Name="AnalyzeSelectedWpfButton"
                                    Width="180"
                                    Padding="12,4"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    IsEnabled="{Binding CanAnalyzeSelectedWpf}"
                                    Click="InjectButton_OnClick"
                                    Content="PDB 解析と UI 走査" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding WpfInspectionSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="外部プロセスではインジェクション、WpfInspector 自身ではアプリ内走査を実行します。" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Grid.Row="1"
                                     Margin="0,10,0,10"
                                     Columns="3">
                            <Border Style="{StaticResource SummaryPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="対象プロセス" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding SelectedProcessHeadline}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="{Binding SelectedProcessPdbSummary}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SummaryPanelStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="UI 走査" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding UiResultSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="{Binding RuntimeAssemblySummary}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0"
                                    Padding="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="PDB 解析" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding PdbResultSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="{Binding PdbSummary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TabControl Grid.Row="2">
                            <TabItem Header="UI ツリー">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Content="ウィンドウ" />
                                        <ComboBox Grid.Column="1"
                                                  IsEnabled="{Binding HasInspectionResult}"
                                                  ItemsSource="{Binding InspectedWindows}"
                                                  SelectedItem="{Binding SelectedInspectedWindow}"
                                                  DisplayMemberPath="Title" />
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="{Binding SelectedInspectedWindowSummary}" />

                                    <TreeView Grid.Row="2"
                                              ItemsSource="{Binding SelectedInspectedWindowRoots}">
                                        <TreeView.Resources>
                                            <HierarchicalDataTemplate DataType="{x:Type models:WpfElementInfo}"
                                                                      ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="2,1">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding TypeName}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               Visibility="{Binding DataContextTypeName, Converter={StaticResource NullToCollapsedConverter}}"
                                                               Text="{Binding DataContextTypeName, StringFormat=DataContext: {0}}"
                                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>
                                </Grid>
                            </TabItem>

                            <TabItem Header="PDB 解析">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,0,8,8"
                                               VerticalAlignment="Center"
                                               Content="PDB" />
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Margin="0,0,8,8"
                                                 Text="{Binding PdbPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Row="0"
                                                Grid.Column="2"
                                                MinWidth="92"
                                                Padding="12,4"
                                                Margin="0,0,0,8"
                                                Click="BrowsePdbButton_OnClick"
                                                Content="参照" />

                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Content="Assembly" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding AssemblyPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Row="1"
                                                Grid.Column="2"
                                                MinWidth="92"
                                                Padding="12,4"
                                                Click="BrowseAssemblyButton_OnClick"
                                                Content="参照" />
                                    </Grid>

                                    <DockPanel Grid.Row="1"
                                               Margin="0,10,0,10"
                                               LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Width="120"
                                                Padding="12,4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top"
                                                Click="AnalyzePdbButton_OnClick"
                                                Content="PDB を解析" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding PdbSummary}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding PdbWarningsText}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TabControl Grid.Row="2">
                                        <TabItem Header="Documents">
                                            <DataGrid AutoGenerateColumns="False"
                                                      ItemsSource="{Binding Documents}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Document"
                                                                        Width="3*"
                                                                        Binding="{Binding Name}" />
                                                    <DataGridTextColumn Header="Language"
                                                                        Width="120"
                                                                        Binding="{Binding Language}" />
                                                    <DataGridTextColumn Header="Hash"
                                                                        Width="160"
                                                                        Binding="{Binding HashAlgorithm}" />
                                                    <DataGridTextColumn Header="Hash Size"
                                                                        Width="100"
                                                                        Binding="{Binding HashLength}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>

                                        <TabItem Header="Methods">
                                            <DataGrid AutoGenerateColumns="False"
                                                      ItemsSource="{Binding Methods}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Token"
                                                                        Width="120"
                                                                        Binding="{Binding Token, StringFormat=0x{0:X8}}" />
                                                    <DataGridTextColumn Header="Method"
                                                                        Width="2.4*"
                                                                        Binding="{Binding DisplayName}" />
                                                    <DataGridTextColumn Header="Document"
                                                                        Width="2*"
                                                                        Binding="{Binding Document}" />
                                                    <DataGridTextColumn Header="Seq"
                                                                        Width="90"
                                                                        Binding="{Binding SequencePointCount}" />
                                                    <DataGridTextColumn Header="Visible"
                                                                        Width="90"
                                                                        Binding="{Binding VisibleSequencePointCount}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
