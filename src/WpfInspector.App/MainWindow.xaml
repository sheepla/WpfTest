<Window x:Class="WpfInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WpfInspector.Core.Models;assembly=WpfInspector.Core"
        xmlns:converters="clr-namespace:WpfInspector.App.Converters"
        mc:Ignorable="d"
        Title="WpfInspector"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1220"
        Background="#F2F5F7"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBF8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFF7F4" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFD9E0E5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1E2934" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF5C6E7E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF007A78" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFDDF4F1" />
        <SolidColorBrush x:Key="HeroBrush" Color="#FF123848" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FFF9FBFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                Padding="24"
                CornerRadius="28"
                Background="{StaticResource HeroBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="WpfInspector" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#FFD4E7EE"
                               Text="選択した WPF プロセス、または WpfInspector 自身を走査し、ランタイム情報を使って PDB と UI ツリーを解析するデスクトップツール" />
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Width="360"
                        Padding="16"
                        CornerRadius="20"
                        Background="#1FFFFFFF">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF4D06F"
                                   Text="INSPECTION FLOW" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   Text="プロセス一覧から WPF を選択すると、ランタイム UI 情報を取得し、その結果を使って解析対象 PDB を自動決定できます。WpfInspector 自身を選んだ場合は直接走査します。" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.93*" />
                <ColumnDefinition Width="1.07*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,14">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Process Explorer" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="実行中プロセスから対象 WPF を選択し、Self 列で WpfInspector 自身を見分けながら状態確認と解析対象の確定を行います。" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 x:Name="ProcessFilterTextBox"
                                 Margin="0,0,12,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                x:Name="RefreshButton"
                                Width="112"
                                Click="RefreshButton_OnClick"
                                Content="Refresh" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      x:Name="ShowBackgroundProcessesCheckBox"
                                      VerticalAlignment="Center"
                                      Content="バックグラウンドも表示"
                                      IsChecked="{Binding ShowBackgroundProcesses}" />

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding ProcessCountSummary}" />
                        </Grid>
                    </Grid>

                    <DataGrid x:Name="ProcessesGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding ProcessesView}"
                              SelectedItem="{Binding SelectedProcess}"
                              SelectionChanged="ProcessesGrid_OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process"
                                                Width="2*"
                                                Binding="{Binding ProcessName}" />
                            <DataGridTextColumn Header="PID"
                                                Width="90"
                                                Binding="{Binding ProcessId}" />
                            <DataGridCheckBoxColumn Header="Self"
                                                    Width="70"
                                                    Binding="{Binding IsCurrentProcess}" />
                            <DataGridCheckBoxColumn Header="Alive"
                                                    Width="80"
                                                    Binding="{Binding IsResponding}" />
                            <DataGridTextColumn Header="Window Title"
                                                Width="3*"
                                                Binding="{Binding WindowTitle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="16"
                            CornerRadius="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal">
                                    <Border Margin="0,0,8,0"
                                            Padding="10,4"
                                            CornerRadius="10"
                                            Background="#FFE7EEF7"
                                            Visibility="{Binding SelectedProcessSnapshot.Summary.IsCurrentProcess, Converter={StaticResource BoolToVisibilityConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#FF365B7D"
                                                   Text="SELF" />
                                    </Border>
                                    <Border Padding="10,4"
                                            CornerRadius="10"
                                            Background="{StaticResource AccentSoftBrush}"
                                            Visibility="{Binding IsWpfProcess, Converter={StaticResource BoolToVisibilityConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="WPF" />
                                    </Border>
                                </StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           x:Name="SelectedProcessHeadlineText"
                                           Text="{Binding SelectedProcessHeadline}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedProcessPath}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedProcessMetrics}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedProcessNotes}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.74*" />
                    <RowDefinition Height="1.26*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,14">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Loaded Modules" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="CodeView 情報を読み取り、選択した WPF のメインモジュールと関連 PDB 候補を確認します。自己プロセスでも同じ基準で候補を表示します。" />
                        </StackPanel>

                        <DataGrid x:Name="ModulesGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Modules}"
                                  SelectedItem="{Binding SelectedModule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module"
                                                    Width="1.5*"
                                                    Binding="{Binding ModuleName}" />
                                <DataGridTextColumn Header="Base"
                                                    Width="115"
                                                    Binding="{Binding BaseAddress, StringFormat=0x{0:X}}" />
                                <DataGridTextColumn Header="Size"
                                                    Width="100"
                                                    Binding="{Binding ModuleMemorySize, StringFormat={}{0:N0}}" />
                                <DataGridTextColumn Header="Symbol"
                                                    Width="140"
                                                    Binding="{Binding SymbolInfo.SymbolState}" />
                                <DataGridCheckBoxColumn Header="PDB"
                                                        Width="72"
                                                        Binding="{Binding SymbolInfo.SuggestedPdbExists}" />
                                <DataGridTextColumn Header="Candidate Path"
                                                    Width="3*"
                                                    Binding="{Binding SymbolInfo.SuggestedPdbPath}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="14"
                                CornerRadius="18"
                                Background="{StaticResource AccentSoftBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,12,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding SelectedModuleSummary}" />
                                    <TextBlock Margin="0,6,0,0"
                                               x:Name="SelectedProcessPdbSummaryText"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding SelectedProcessPdbSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="196"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanUseSelectedModulePdb}"
                                        Click="UseSelectedModulePdbButton_OnClick"
                                        Content="選択モジュールのPDBを使う" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,14">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Analysis Console" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="選択した WPF プロセスを対象に、UI 走査で収集したランタイム情報と PDB 解析結果を一画面で確認します。WpfInspector 自身を選んだ場合も同じ画面で検証できます。" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="14"
                                    CornerRadius="18"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="STEP 1" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Target WPF" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedProcessHeadline}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding SelectedProcessPdbSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="8,0"
                                    Padding="14"
                                    CornerRadius="18"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="STEP 2" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Runtime Scan" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding UiResultSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding RuntimeAssemblySummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="14"
                                    CornerRadius="18"
                                    Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="STEP 3" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="Portable PDB" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding PdbResultSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding SelectedProcessPdbSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="14"
                                CornerRadius="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,14,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding WpfInspectionSummary}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="一括実行では、先にランタイム走査を実行します。外部プロセスでは検査ペイロードを注入し、WpfInspector 自身を選んだ場合はアプリ内で直接 UI ツリーを収集します。"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="AnalyzeSelectedWpfButton"
                                        Width="176"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding CanAnalyzeSelectedWpf}"
                                        Click="InjectButton_OnClick"
                                        Content="PDB解析とUI走査" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.92*" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Padding="16"
                                    CornerRadius="20"
                                    Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="Visual Tree" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="検出したウィンドウを選択すると、ルート要素からビジュアルツリーを展開します。" />
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          Margin="0,14,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="ウィンドウ" />
                                            <ComboBox Grid.Column="1"
                                                      IsEnabled="{Binding HasInspectionResult}"
                                                      ItemsSource="{Binding InspectedWindows}"
                                                      SelectedItem="{Binding SelectedInspectedWindow}"
                                                      DisplayMemberPath="Title" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,10,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding SelectedInspectedWindowSummary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Border Grid.Row="2"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TreeView ItemsSource="{Binding SelectedInspectedWindowRoots}"
                                                  Background="White">
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type models:WpfElementInfo}"
                                                                          ItemsSource="{Binding Children}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="2,1">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding TypeName}"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   Text="{Binding Name}"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Visibility="{Binding DataContextTypeName, Converter={StaticResource NullToCollapsedConverter}}"
                                                                   Text="{Binding DataContextTypeName, StringFormat=({0})}" />
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="16"
                                    CornerRadius="20"
                                    Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="PDB Details" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="走査後に解決した対象 PDB が自動入力されます。必要に応じて別パスへ切り替えて確認できます。" />
                                    </StackPanel>

                                    <Grid Grid.Row="1"
                                          Margin="0,14,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="PDB" />
                                            <TextBox Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Text="{Binding PdbPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Width="92"
                                                    Click="BrowsePdbButton_OnClick"
                                                    Content="Browse" />
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="Assembly" />
                                            <TextBox Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Text="{Binding AssemblyPath, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Width="92"
                                                    Click="BrowseAssemblyButton_OnClick"
                                                    Content="Browse" />
                                        </Grid>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="14"
                                            CornerRadius="18"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding PdbSummary}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Text="{Binding PdbWarningsText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Width="120"
                                                    Click="AnalyzePdbButton_OnClick"
                                                    Content="Analyze" />
                                        </DockPanel>
                                    </Border>

                                    <TabControl Grid.Row="3"
                                                Margin="0,14,0,0"
                                                Background="Transparent"
                                                BorderThickness="0">
                                        <TabItem Header="Documents">
                                            <DataGrid ItemsSource="{Binding Documents}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Document"
                                                                        Width="3*"
                                                                        Binding="{Binding Name}" />
                                                    <DataGridTextColumn Header="Language"
                                                                        Width="120"
                                                                        Binding="{Binding Language}" />
                                                    <DataGridTextColumn Header="Hash"
                                                                        Width="160"
                                                                        Binding="{Binding HashAlgorithm}" />
                                                    <DataGridTextColumn Header="Hash Size"
                                                                        Width="100"
                                                                        Binding="{Binding HashLength}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Methods">
                                            <DataGrid ItemsSource="{Binding Methods}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Token"
                                                                        Width="120"
                                                                        Binding="{Binding Token, StringFormat=0x{0:X8}}" />
                                                    <DataGridTextColumn Header="Method"
                                                                        Width="2.4*"
                                                                        Binding="{Binding DisplayName}" />
                                                    <DataGridTextColumn Header="Document"
                                                                        Width="2*"
                                                                        Binding="{Binding Document}" />
                                                    <DataGridTextColumn Header="Seq"
                                                                        Width="90"
                                                                        Binding="{Binding SequencePointCount}" />
                                                    <DataGridTextColumn Header="Visible"
                                                                        Width="90"
                                                                        Binding="{Binding VisibleSequencePointCount}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="18"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="180"
                             Height="8"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center"
                           x:Name="StatusMessageText"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
