<Window x:Class="WpfInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WpfInspector"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1220"
        Background="#F2F5F7"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFBF8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFF7F4" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFD9E0E5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1E2934" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF5C6E7E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF007A78" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFDDF4F1" />
        <SolidColorBrush x:Key="HeroBrush" Color="#FF123848" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FFF9FBFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,18"
                Padding="24"
                CornerRadius="28"
                Background="{StaticResource HeroBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="WpfInspector" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#FFD4E7EE"
                               Text="WPF プロセスの状態、モジュール、Portable PDB を一画面で解析するデスクトップツール" />
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Width="360"
                        Padding="16"
                        CornerRadius="20"
                        Background="#1FFFFFFF">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF4D06F"
                                   Text="SECURITY BOUNDARY" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="White"
                                   Text="任意 DLL 注入は含めず、プロセス観測と PE / PDB 解析に限定しています。将来拡張は安全なアタッチ方式を前提にします。" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.93*" />
                <ColumnDefinition Width="1.07*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,14">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Process Explorer" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="実行中プロセスを選択し、対象アプリの状態とモジュール構成を確認します。" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,12,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Width="112"
                                Click="RefreshButton_OnClick"
                                Content="Refresh" />
                    </Grid>

                    <DataGrid x:Name="ProcessesGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding ProcessesView}"
                              SelectedItem="{Binding SelectedProcess}"
                              SelectionChanged="ProcessesGrid_OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process"
                                                Width="2*"
                                                Binding="{Binding ProcessName}" />
                            <DataGridTextColumn Header="PID"
                                                Width="90"
                                                Binding="{Binding ProcessId}" />
                            <DataGridCheckBoxColumn Header="Alive"
                                                    Width="80"
                                                    Binding="{Binding IsResponding}" />
                            <DataGridTextColumn Header="Window Title"
                                                Width="3*"
                                                Binding="{Binding WindowTitle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="16"
                            CornerRadius="18"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedProcessHeadline}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedProcessPath}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SelectedProcessMetrics}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{Binding SelectedProcessNotes}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.92*" />
                    <RowDefinition Height="1.08*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,14">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Loaded Modules" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="CodeView 情報を読み取り、対象モジュールの PDB 候補とシンボル状態を推定します。" />
                        </StackPanel>

                        <DataGrid x:Name="ModulesGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Modules}"
                                  SelectedItem="{Binding SelectedModule}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Module"
                                                    Width="1.5*"
                                                    Binding="{Binding ModuleName}" />
                                <DataGridTextColumn Header="Base"
                                                    Width="115"
                                                    Binding="{Binding BaseAddress, StringFormat=0x{0:X}}" />
                                <DataGridTextColumn Header="Size"
                                                    Width="100"
                                                    Binding="{Binding ModuleMemorySize, StringFormat={}{0:N0}}" />
                                <DataGridTextColumn Header="Symbol"
                                                    Width="140"
                                                    Binding="{Binding SymbolInfo.SymbolState}" />
                                <DataGridCheckBoxColumn Header="PDB"
                                                        Width="72"
                                                        Binding="{Binding SymbolInfo.SuggestedPdbExists}" />
                                <DataGridTextColumn Header="Candidate Path"
                                                    Width="3*"
                                                    Binding="{Binding SymbolInfo.SuggestedPdbPath}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Margin="0,14,0,0"
                                Padding="14"
                                CornerRadius="18"
                                Background="{StaticResource AccentSoftBrush}">
                            <DockPanel>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding SelectedModuleSummary}" />
                                <Button DockPanel.Dock="Right"
                                        Width="180"
                                        IsEnabled="{Binding CanUseSelectedModulePdb}"
                                        Click="UseSelectedModulePdbButton_OnClick"
                                        Content="Use Selected Module PDB" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,14">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="Portable PDB Analyzer" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="PDB と任意のアセンブリを指定し、ソース文書とメソッド単位のデバッグ情報を解析します。" />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="PDB" />
                            <TextBox Grid.Column="1"
                                     Margin="0,0,12,0"
                                     Text="{Binding PdbPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Click="BrowsePdbButton_OnClick"
                                    Content="Browse" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Assembly" />
                            <TextBox Grid.Column="1"
                                     Margin="0,0,12,0"
                                     Text="{Binding AssemblyPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Width="92"
                                    Click="BrowseAssemblyButton_OnClick"
                                    Content="Browse" />
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="0,0,0,14"
                                Padding="14"
                                CornerRadius="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding PdbSummary}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding PdbWarningsText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Width="120"
                                        Click="AnalyzePdbButton_OnClick"
                                        Content="Analyze" />
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="4"
                              Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,10"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Documents" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Documents}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Document"
                                                        Width="3*"
                                                        Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="Language"
                                                        Width="120"
                                                        Binding="{Binding Language}" />
                                    <DataGridTextColumn Header="Hash"
                                                        Width="160"
                                                        Binding="{Binding HashAlgorithm}" />
                                    <DataGridTextColumn Header="Hash Size"
                                                        Width="100"
                                                        Binding="{Binding HashLength}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Grid.Row="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,10"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Methods" />

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Methods}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Token"
                                                        Width="120"
                                                        Binding="{Binding Token, StringFormat=0x{0:X8}}" />
                                    <DataGridTextColumn Header="Method"
                                                        Width="2.4*"
                                                        Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Header="Document"
                                                        Width="2*"
                                                        Binding="{Binding Document}" />
                                    <DataGridTextColumn Header="Seq"
                                                        Width="90"
                                                        Binding="{Binding SequencePointCount}" />
                                    <DataGridTextColumn Header="Visible"
                                                        Width="90"
                                                        Binding="{Binding VisibleSequencePointCount}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="18"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="180"
                             Height="8"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
