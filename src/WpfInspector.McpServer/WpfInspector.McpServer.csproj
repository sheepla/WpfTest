<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WpfInspector.McpServer</RootNamespace>
    <CompatibleInjectionTargetFramework>net8.0-windows</CompatibleInjectionTargetFramework>
    <CompatibleInjectionCoreTargetFramework>net8.0</CompatibleInjectionCoreTargetFramework>
    <CompatibleInjectionAssetsOutputDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\InjectionAssets\$(CompatibleInjectionTargetFramework)\</CompatibleInjectionAssetsOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfInspector.Core\WpfInspector.Core.csproj" />
    <ProjectReference Include="..\WpfInspector.Injector\WpfInspector.Injector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\WpfInspector.TestHelper\Protocol\PipeProtocol.cs" Link="Protocol\PipeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\WpfInspector.NativeBootstrap\x64\Debug\WpfInspector.NativeBootstrap.dll"
             Condition="Exists('$(MSBuildThisFileDirectory)..\WpfInspector.NativeBootstrap\x64\Debug\WpfInspector.NativeBootstrap.dll')"
             CopyToOutputDirectory="PreserveNewest"
             Link="WpfInspector.NativeBootstrap.dll" />
    <Content Include="$(MSBuildThisFileDirectory)..\WpfInspector.NativeBootstrap\x64\Release\WpfInspector.NativeBootstrap.dll"
             Condition="Exists('$(MSBuildThisFileDirectory)..\WpfInspector.NativeBootstrap\x64\Release\WpfInspector.NativeBootstrap.dll')"
             CopyToOutputDirectory="PreserveNewest"
             Link="WpfInspector.NativeBootstrap.dll" />
  </ItemGroup>

  <Target Name="CopyTestHelper" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\WpfInspector.TestHelper.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\WpfInspector.TestHelper.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\WpfInspector.TestRuntime.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\WpfInspector.TestRuntime.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows" />
    <ItemGroup>
      <_TestHelperFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\bin\$(Configuration)\net10.0-windows\WpfInspector.TestHelper.*" />
      <_TestHelperFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\bin\$(Configuration)\net10.0-windows\WpfInspector.TestRuntime.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestHelperFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <!-- hostfxr セカンダリコンテキスト向けに runtimeconfig を最小構成で上書き -->
    <WriteLinesToFile
      File="$(OutputPath)WpfInspector.TestHelper.runtimeconfig.json"
      Lines='{
  "runtimeOptions": {
    "tfm": "net10.0",
    "rollForward": "LatestMinor",
    "frameworks": [
      {
        "name": "Microsoft.NETCore.App",
        "version": "10.0.0"
      }
    ]
  }
}'
      Overwrite="true" Encoding="UTF-8" />
  </Target>

  <Target Name="CopyInspectionPayload" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.InspectionPayload\WpfInspector.InspectionPayload.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.InspectionPayload\WpfInspector.InspectionPayload.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0-windows" />
    <ItemGroup>
      <_PayloadFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.InspectionPayload\bin\$(Configuration)\net10.0-windows\WpfInspector.InspectionPayload.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PayloadFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCompatibleInjectionAssets" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\WpfInspector.TestHelper.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\WpfInspector.TestHelper.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(CompatibleInjectionTargetFramework)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\WpfInspector.TestRuntime.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\WpfInspector.TestRuntime.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(CompatibleInjectionTargetFramework)" />
    <MakeDir Directories="$(CompatibleInjectionAssetsOutputDir)" />
    <ItemGroup>
      <_CompatibleInjectionFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.TestHelper\bin\$(Configuration)\$(CompatibleInjectionTargetFramework)\WpfInspector.TestHelper.*" />
      <_CompatibleInjectionFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.TestRuntime\bin\$(Configuration)\$(CompatibleInjectionTargetFramework)\WpfInspector.TestRuntime.*" />
      <_CompatibleInjectionFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.InspectionPayload\bin\$(Configuration)\$(CompatibleInjectionTargetFramework)\WpfInspector.InspectionPayload.*" />
      <_CompatibleInjectionFiles Include="$(MSBuildThisFileDirectory)..\WpfInspector.Core\bin\$(Configuration)\$(CompatibleInjectionCoreTargetFramework)\WpfInspector.Core.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompatibleInjectionFiles)" DestinationFolder="$(CompatibleInjectionAssetsOutputDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile
      File="$(CompatibleInjectionAssetsOutputDir)WpfInspector.TestHelper.runtimeconfig.json"
      Lines='{
  "runtimeOptions": {
    "tfm": "net8.0",
    "rollForward": "LatestMajor",
    "frameworks": [
      {
        "name": "Microsoft.NETCore.App",
        "version": "8.0.0"
      }
    ]
  }
}'
      Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
